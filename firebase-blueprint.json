{
  "entities": {
    "CafeInfo": {
      "title": "CafeInfo",
      "description": "General cafe branding and settings",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "banner": { "type": "string" },
        "logo": { "type": "string" },
        "instagram": { "type": "string" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Menu category",
      "type": "object",
      "properties": {
        "nameUk": { "type": "string" },
        "nameHu": { "type": "string" },
        "nameEn": { "type": "string" },
        "photo": { "type": "string" }
      },
      "required": ["nameUk"]
    },
    "Product": {
      "title": "Product",
      "description": "Menu product/dish item",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string" },
        "nameUk": { "type": "string" },
        "nameHu": { "type": "string" },
        "nameEn": { "type": "string" },
        "price": { "type": "number" },
        "photo": { "type": "string" }
      },
      "required": ["nameUk", "price", "categoryId"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and role in the system",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "customer"] }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "CafeInfo" },
      "description": "Global cafe settings and info"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "Category" },
      "description": "Menu categories"
    },
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Menu products"
    },
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profiles"
    }
  }
}
