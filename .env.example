# Supabase configuration. Copy to `.env.local` and fill from Supabase dashboard
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# GitHub personal access token (classic) with repo scope.
# Required for backfill scripts. Never expose in client-side code.
GITHUB_TOKEN="YOUR_GITHUB_TOKEN"

# Supabase service_role key (secret, full access to all tables/RPCs).
# ONLY for server-side scripts (backfill-photos.mjs). NEVER set in
# Vercel env for client or server-rendered pages — use anon key instead.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
